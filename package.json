{
  "name": "overexposed",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "sim": "node sim/run.ts",
    "sim:awards": "node sim/awards.ts",
    "sim:tiers": "node sim/tiers.ts",
    "sim:variants": "node sim/variants.ts",
    "sim:press": "node sim/press.ts",
    "sim:managers": "node sim/managers.ts",
    "sim:memory": "node sim/memory.ts",
    "validate": "node validate/run.ts",
    "check:preview": "node check/press-contract.ts && node check/preview.ts",
    "check:clicks": "node check/clicks.ts",
    "check:overflow": "node check/overflow.ts",
    "check:overflow:full": "node check/overflow.ts --runs=10 --replays",
    "check:interactions": "node check/interactions.ts",
    "check:notes": "node check/notes.ts",
    "desk:states": "node tools/desk-states.ts",
    "desk:shots": "node tools/desk-shots.ts",
    "desk:compare": "node tools/desk-compare.ts",
    "desk:photos": "node tools/desk-photos.ts",
    "desk:sheet": "node tools/contact-sheet.ts",
    "sim:baseline": "node sim/baseline.ts",
    "sim:compare": "node sim/compare.ts",
    "tune:thresholds": "node sim/tune/thresholds.ts",
    "tune:endings": "node sim/tune/endings.ts",
    "tune:lanes": "node sim/tune/lanes.ts",
    "tune:try": "node sim/tune/try.ts",
    "typecheck": "tsc -b",
    "check:queue": "node check/queue.ts && node check/timeline.ts && node check/pace.ts --runs=12",
    "check:motion": "node check/motion-run.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
