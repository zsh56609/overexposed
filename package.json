{
  "name": "overexposed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "sim": "node sim/run.ts",
    "sim:awards": "node sim/awards.ts",
    "sim:tiers": "node sim/tiers.ts",
    "sim:variants": "node sim/variants.ts",
    "validate": "node validate/run.ts",
    "check:preview": "node check/preview.ts && node check/clicks.ts",
    "check:clicks": "node check/clicks.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
